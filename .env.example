MUSIC_ROOT=./music
MAX_UPLOAD_MB=25
MAX_TOTAL_UPLOAD_MB=200
QUEUE_HISTORY_LIMIT=50
SCAN_ON_STARTUP=true
JWT_SECRET_KEY=dev-secret-change-in-production
# --- Autenticación / MongoDB Atlas ---
# Sin MONGO_URI la app usa un almacén en memoria (solo desarrollo)
# Producción (Atlas): mongodb+srv://zorryfy_app:<password>@<cluster>.mongodb.net/zorryfy?retryWrites=true&w=majority
MONGO_URI=mongodb://zorryfy_app:zorryfy_app_dev_password@localhost:27017/zorryfy?authSource=zorryfy
MONGO_DB=zorryfy
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_dev_password
MONGO_APP_USER=zorryfy_app
MONGO_APP_PASSWORD=zorryfy_app_dev_password
# Zona horaria del token diario (America/Bogota = -5)
# Solo para la fecha del registro de sesión; el token dura 24 h
AUTH_TZ_OFFSET_HOURS=-5
PBKDF2_ITERATIONS=600000
TERMS_VERSION=1.0
# --- Cifrado de datos del usuario (AES-256-GCM) ---
# Generar con: python -m app.crypto  (guardar en AWS Secrets Manager en producción)
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_OLD_KEYS=
BLIND_INDEX_KEY=
# --- Notificaciones push para confirmar el email (Web Push / VAPID) ---
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@zorryfy.app
# Solo en redes con inspección TLS (proxy corporativo): usar los certificados del sistema
PUSH_USE_SYSTEM_CERTS=false
# --- Taller / demo: crea demo/demo123 y acepta el código 2FA 123456. NUNCA en producción ---
DEMO_MODE=false
